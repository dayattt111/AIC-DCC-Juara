# =============================================================
# Kopita Environment Configuration Template (.env.example)
# Salin berkas ini menjadi .env sebelum menjalankan aplikasi:
#   cp .env.example .env
# =============================================================

# --- Backend Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEVICE=cpu
MODEL_PATH=model/best_torajigrade_model.pth
APP_ENV=production

# --- Frontend & API Client Configuration ---
# Untuk lingkungan lokal (non-Docker): http://127.0.0.1:8000
# Untuk lingkungan Docker Compose   : http://backend:8000
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_PORT=8501
REQUEST_TIMEOUT=30
